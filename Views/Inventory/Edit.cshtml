@model MerceditasStore.Models.InventoryProduct
@{
    ViewData["Title"] = "Edit Product";
}

@await Html.PartialAsync("_PageHeader", new MerceditasStore.Models.PageHeaderModel
{
    Title = "Edit Product",
    Subtitle = Model.Name,
    Actions = new Microsoft.AspNetCore.Html.HtmlString($"<a class='btn btn--ghost' href='{Url.Action("Index", "Inventory")}'>Back</a>")
})

<div class="card form-card">
    <div class="card__head">
        <div class="card__title">PRODUCT DETAILS</div>
    </div>
    <div class="card__body">
        <form method="post" asp-action="Edit">
            <input type="hidden" asp-for="Id" />

            <div class="form-grid form-grid--1">
                <div class="field">
                    <label class="label" asp-for="Name">Name</label>
                    <input class="input" asp-for="Name" />
                    <div class="validation">@Html.ValidationMessageFor(m => m.Name)</div>
                </div>
            </div>

            <div class="form-grid">
                <div class="field">
                    <label class="label" asp-for="Unit">Unit</label>
                    <input class="input" asp-for="Unit" placeholder="pc / kg / sachet" />
                    <div class="validation">@Html.ValidationMessageFor(m => m.Unit)</div>
                </div>
                <div class="field">
                    <label class="label" asp-for="Stock">Stock</label>
                    <input class="input" asp-for="Stock" type="number" step="0.01" />
                    <div class="validation">@Html.ValidationMessageFor(m => m.Stock)</div>
                </div>
                <div class="field">
                    <label class="label" asp-for="BuyPrice">Buy Price</label>
                    <input class="input" asp-for="BuyPrice" type="number" step="0.01" />
                    <div class="validation">@Html.ValidationMessageFor(m => m.BuyPrice)</div>
                </div>
                <div class="field">
                    <label class="label" asp-for="SellPrice">Sell Price</label>
                    <input class="input" asp-for="SellPrice" type="number" step="0.01" />
                    <div class="validation">@Html.ValidationMessageFor(m => m.SellPrice)</div>
                </div>
                <div class="field">
                    <label class="label" asp-for="LowStockThreshold">Low Stock Threshold</label>
                    <input class="input" asp-for="LowStockThreshold" type="number" step="0.01" />
                    <div class="validation">@Html.ValidationMessageFor(m => m.LowStockThreshold)</div>
                </div>
            </div>

            <div class="form-actions">
                <button class="btn btn--success" type="submit">Save Changes</button>
                <a class="btn btn--outline" asp-controller="Inventory" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

